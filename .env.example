# Spotify app credentials — https://developer.spotify.com/dashboard
# Copy this file to ".env" and fill in your values. The real .env is git-ignored.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Deployment only (leave unset for local dev) ---------------------------
# Stable secret for signing session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, an ephemeral per-process key is used (fine locally; logs users out
# on every restart when deployed, so set this in production).
# SESSION_SECRET=

# Full public OAuth callback URL, registered in the Spotify dashboard.
# Defaults to http://127.0.0.1:8888/callback for local dev.
# RUNIC_REDIRECT_URI=https://your-app.example.com/callback

# Bind host for the server. Local default 127.0.0.1; set 0.0.0.0 when deployed.
# HOST=0.0.0.0
